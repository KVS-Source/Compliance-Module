model Checkpoint {
  id                    String                 @id @default(uuid()) @db.Uuid
  tenantId              String                 @map("tenant_id") @db.Uuid
  controlId             String                 @map("control_id") @db.Uuid
  code                  String
  title                 String
  description           String?                @db.Text
  verificationFrequency KpiFrequency           @map("verification_frequency")
  ownerId               String?                @map("owner_id") @db.Uuid
  departmentId          String?                @map("department_id") @db.Uuid
  expectedResult        String                 @map("expected_result") @db.Text
  evidenceRequired      Boolean                @default(false) @map("evidence_required")
  lifecycleStatus       GovernanceRecordStatus @default(ACTIVE) @map("lifecycle_status")
  initialReviewDate     DateTime?              @map("initial_review_date") @db.Date
  nextReviewDate        DateTime?              @map("next_review_date") @db.Date
  latestReviewId        String?                @map("latest_review_id") @db.Uuid
  lastReviewedAt        DateTime?              @map("last_reviewed_at") @db.Timestamptz(6)
  createdById           String                 @map("created_by_id") @db.Uuid
  updatedById           String                 @map("updated_by_id") @db.Uuid
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt            DateTime?              @map("archived_at") @db.Timestamptz(6)
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  control               Control                @relation(fields: [tenantId, controlId], references: [tenantId, id], onDelete: Restrict)
  owner                 User?                  @relation("CheckpointOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  department            OrgDepartment?         @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Restrict)
  latestReview          CheckpointReview?      @relation("CheckpointLatestReview", fields: [tenantId, id, latestReviewId], references: [tenantId, checkpointId, id], onDelete: Restrict)
  reviews               CheckpointReview[]     @relation("CheckpointReviews")
  createdBy             User                   @relation("CheckpointCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy             User                   @relation("CheckpointUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  evidenceLinks         EvidenceCheckpointLink[]
  gaps                  Gap[]

  @@unique([tenantId, id])
  @@unique([tenantId, id, latestReviewId])
  @@unique([tenantId, code])
  @@index([tenantId, controlId, lifecycleStatus])
  @@index([tenantId, ownerId])
  @@index([tenantId, departmentId])
  @@index([tenantId, nextReviewDate])
  @@index([latestReviewId])
  @@map("checkpoints")
}

model CheckpointReview {
  id                  String            @id @default(uuid()) @db.Uuid
  tenantId            String            @map("tenant_id") @db.Uuid
  checkpointId        String            @map("checkpoint_id") @db.Uuid
  reviewPeriod        String            @map("review_period") @db.VarChar(48)
  reviewDate          DateTime          @map("review_date") @db.Date
  reviewerId          String            @map("reviewer_id") @db.Uuid
  outcome             CheckpointOutcome
  observation         String?           @db.Text
  recommendation      String?           @db.Text
  nextReviewDate      DateTime?         @map("next_review_date") @db.Date
  submittedAt         DateTime          @default(now()) @map("submitted_at") @db.Timestamptz(6)
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  checkpoint          Checkpoint        @relation("CheckpointReviews", fields: [tenantId, checkpointId], references: [tenantId, id], onDelete: Restrict)
  latestForCheckpoint Checkpoint?       @relation("CheckpointLatestReview")
  reviewer            User              @relation("CheckpointReviewReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, checkpointId, id])
  @@unique([tenantId, checkpointId, reviewPeriod])
  @@index([tenantId, checkpointId, reviewDate])
  @@index([tenantId, reviewerId, submittedAt])
  @@map("checkpoint_reviews")
}

model Evidence {
  id                   String                  @id @default(uuid()) @db.Uuid
  tenantId             String                  @map("tenant_id") @db.Uuid
  code                 String
  title                String
  description          String?                 @db.Text
  lifecycleStatus      EvidenceLifecycleStatus @default(DRAFT) @map("lifecycle_status")
  ownerId              String?                 @map("owner_id") @db.Uuid
  departmentId         String?                 @map("department_id") @db.Uuid
  issueDate            DateTime?               @map("issue_date") @db.Date
  expiresAt            DateTime?               @map("expires_at") @db.Date
  supersedesEvidenceId String?                 @map("supersedes_evidence_id") @db.Uuid
  submittedById        String?                 @map("submitted_by_id") @db.Uuid
  submittedAt          DateTime?               @map("submitted_at") @db.Timestamptz(6)
  reviewedById         String?                 @map("reviewed_by_id") @db.Uuid
  reviewedAt           DateTime?               @map("reviewed_at") @db.Timestamptz(6)
  archivedAt           DateTime?               @map("archived_at") @db.Timestamptz(6)
  originalFileName     String?                 @map("original_file_name")
  storageKey           String?                 @map("storage_key")
  mimeType             String?                 @map("mime_type")
  detectedMimeType     String?                 @map("detected_mime_type")
  byteSize             Int?                    @map("byte_size")
  contentSha256        String?                 @map("content_sha256")
  /// The `File Link / Path` string carried by an imported workbook row. It is
  /// a claim made by a spreadsheet, never proof of a stored file: only a
  /// non-null `storageKey` means this platform actually holds the bytes.
  sourceFileReference  String?                 @map("source_file_reference")
  uploadedById         String?                 @map("uploaded_by_id") @db.Uuid
  uploadedAt           DateTime?               @map("uploaded_at") @db.Timestamptz(6)
  createdById          String                  @map("created_by_id") @db.Uuid
  updatedById          String                  @map("updated_by_id") @db.Uuid
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant               Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  owner                User?                   @relation("EvidenceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  department           OrgDepartment?          @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Restrict)
  supersedes           Evidence?               @relation("EvidenceSupersession", fields: [tenantId, supersedesEvidenceId], references: [tenantId, id], onDelete: Restrict)
  supersededBy         Evidence[]              @relation("EvidenceSupersession")
  submittedBy          User?                   @relation("EvidenceSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  reviewedBy           User?                   @relation("EvidenceReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  uploadedBy           User?                   @relation("EvidenceUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  createdBy            User                    @relation("EvidenceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy            User                    @relation("EvidenceUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  controlLinks         EvidenceControlLink[]
  checkpointLinks      EvidenceCheckpointLink[]
  kpiActualLinks       EvidenceKpiActualLink[]
  reviewDecisions      EvidenceReviewDecision[]
  gapLinks             GapEvidenceLink[]
  capaLinks            CapaEvidenceLink[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, lifecycleStatus, createdAt])
  @@index([tenantId, ownerId])
  @@index([tenantId, departmentId])
  @@index([tenantId, expiresAt])
  @@index([tenantId, supersedesEvidenceId])
  @@index([tenantId, contentSha256])
  @@map("evidence")
}

