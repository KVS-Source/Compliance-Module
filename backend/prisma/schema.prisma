model KpiDefinition {
  id             String             @id @default(uuid()) @db.Uuid
  code           String             @unique
  name           String
  description    String?
  unit           String
  direction      KpiDirection
  frequency      KpiFrequency
  status         RecordStatus       @default(ACTIVE)
  /// Verbatim clause list from `14_KPI_Master!Compliance Framework Mapping`,
  /// for example `ISO 9001:2015 (9.1.2); CMMI-SVC L3 (SD)`. This is the
  /// client's *declared* mapping and is deliberately kept as written rather
  /// than resolved into `ControlFramework` rows: the workbook states clauses
  /// the Company intends a KPI to evidence, which is a weaker claim than a
  /// governed control mapping and must not be presented as one.
  frameworkMapping String? @map("framework_mapping")
  /// `14_KPI_Master!Default Data Source` — the system the actual is expected
  /// to come from (`Manual Entry`, `Tally`, `HRMS`, …). Advisory only; actual
  /// ingestion is governed by KpiActual.
  defaultDataSource String? @map("default_data_source")
  /// `14_KPI_Master!Owner Suggestion` — the role the workbook recommends as
  /// owner. The binding owner is `KpiConfiguration.ownerId`; this stays a
  /// suggestion so an imported basket never silently assigns accountability.
  ownerSuggestion String? @map("owner_suggestion")
  goals          KpiGoal[]
  configurations KpiConfiguration[]

  @@index([status, name])
  @@map("kpi_definitions")
}

/// Deprecated legacy KPI target. Superseded by KpiTarget; retained unchanged
/// until a later retirement task.
model KpiGoal {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  kpiDefinitionId String        @map("kpi_definition_id") @db.Uuid
  code            String
  targetValue     Decimal       @map("target_value") @db.Decimal(18, 4)
  warningValue    Decimal?      @map("warning_value") @db.Decimal(18, 4)
  criticalValue   Decimal?      @map("critical_value") @db.Decimal(18, 4)
  period          String
  effectiveFrom   DateTime      @map("effective_from") @db.Date
  effectiveTo     DateTime?     @map("effective_to") @db.Date
  status          RecordStatus  @default(ACTIVE)
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  definition      KpiDefinition @relation(fields: [kpiDefinitionId], references: [id], onDelete: Restrict)

  @@unique([tenantId, code])
  @@index([tenantId, status, effectiveFrom])
  @@map("kpi_goals")
}

model KpiConfiguration {
  id                String         @id @default(uuid()) @db.Uuid
  tenantId          String         @map("tenant_id") @db.Uuid
  kpiDefinitionId   String         @map("kpi_definition_id") @db.Uuid
  orgUnitId         String?        @map("org_unit_id") @db.Uuid
  orgLocationId     String?        @map("org_location_id") @db.Uuid
  productService    String?        @map("product_service")
  departmentId      String?        @map("department_id") @db.Uuid
  ownerId           String         @map("owner_id") @db.Uuid
  approverId        String?        @map("approver_id") @db.Uuid
  /// Workbook user token (for example `U-003`). It is traceability metadata,
  /// not an authenticated account and is never used for authorisation.
  sourceOwnerRef    String?        @map("source_owner_ref")
  enabled           Boolean        @default(true)
  currency          String?
  reviewFrequency   KpiFrequency   @map("review_frequency")
  amberThresholdPct Decimal?       @map("amber_threshold_pct") @db.Decimal(6, 2)
  redThresholdPct   Decimal?       @map("red_threshold_pct") @db.Decimal(6, 2)
  requiresEvidence  Boolean        @default(false) @map("requires_evidence")
  requiresApproval  Boolean        @default(true) @map("requires_approval")
  effectiveFrom     DateTime       @map("effective_from") @db.Date
  effectiveTo       DateTime?      @map("effective_to") @db.Date
  status            RecordStatus   @default(ACTIVE)
  createdById       String         @map("created_by_id") @db.Uuid
  updatedById       String         @map("updated_by_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?      @map("deleted_at") @db.Timestamptz(6)
  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  definition        KpiDefinition  @relation(fields: [kpiDefinitionId], references: [id], onDelete: Restrict)
