  sourceRow            Int?               @map("source_row")
  createdById          String             @map("created_by_id") @db.Uuid
  updatedById          String             @map("updated_by_id") @db.Uuid
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime?          @map("deleted_at") @db.Timestamptz(6)
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  gap                  Gap?               @relation(fields: [tenantId, gapId], references: [tenantId, id], onDelete: Restrict)
  framework            Framework?         @relation(fields: [frameworkId], references: [id], onDelete: Restrict)
  owner                User?              @relation("CapaOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  department           OrgDepartment?     @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Restrict)
  createdBy            User               @relation("CapaCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy            User               @relation("CapaUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  importBatch          ImportBatch?       @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
