  @@index([tenantId, priority, status, deletedAt])
  @@index([tenantId, gapId])
  @@index([tenantId, ownerId])
  @@index([tenantId, departmentId])
  @@index([frameworkId])
  @@index([importBatchId])
  @@map("capas")
}

model CapaEvidenceLink {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  capaId      String   @map("capa_id") @db.Uuid
  evidenceId  String   @map("evidence_id") @db.Uuid
  isActive    Boolean  @default(true) @map("is_active")
  linkReason  String?  @map("link_reason") @db.Text
  createdById String   @map("created_by_id") @db.Uuid
  updatedById String   @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  capa        Capa     @relation(fields: [tenantId, capaId], references: [tenantId, id], onDelete: Restrict)
  evidence    Evidence @relation(fields: [tenantId, evidenceId], references: [tenantId, id], onDelete: Restrict)
  createdBy   User     @relation("CapaEvidenceLinkCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User     @relation("CapaEvidenceLinkUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, capaId, evidenceId])
  @@index([tenantId, capaId, isActive])
  @@index([tenantId, evidenceId, isActive])
  @@map("capa_evidence_links")
}

/// Generic container for the workbook registers that do not warrant a
/// dedicated normalised module in this MVP (audit schedule, findings,
/// training, incidents, vendors, privacy, meetings, action items).
model OperationalRegisterType {
  id                 String                      @id @default(uuid()) @db.Uuid
  tenantId           String                      @map("tenant_id") @db.Uuid
  code               String
  name               String
  description        String?
  sourceSheet        String?                     @map("source_sheet")
  /// Ordered column descriptors: `[{ key, label, type }]`. Drives generic
  /// list rendering and CSV export without a per-register schema.
  fieldConfiguration Json                        @default("[]") @map("field_configuration")
  active             Boolean                     @default(true)
  createdAt          DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant             Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  records            OperationalRegisterRecord[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, active, code])
  @@map("operational_register_types")
}

model OperationalRegisterRecord {
  id                 String                  @id @default(uuid()) @db.Uuid
  tenantId           String                  @map("tenant_id") @db.Uuid
  registerTypeId     String                  @map("register_type_id") @db.Uuid
  businessRecordCode String                  @map("business_record_code")
  title              String
  status             String?
  ownerId            String?                 @map("owner_id") @db.Uuid
  sourceOwnerRef     String?                 @map("source_owner_ref")
  departmentId       String?                 @map("department_id") @db.Uuid
  recordDate         DateTime?               @map("record_date") @db.Date
  dueDate            DateTime?               @map("due_date") @db.Date
  sourceSheet        String?                 @map("source_sheet")
  sourceRow          Int?                    @map("source_row")
  importBatchId      String?                 @map("import_batch_id") @db.Uuid
  payload            Json                    @default("{}")
  createdById        String                  @map("created_by_id") @db.Uuid
  updatedById        String                  @map("updated_by_id") @db.Uuid
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?               @map("deleted_at") @db.Timestamptz(6)
  tenant             Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  registerType       OperationalRegisterType @relation(fields: [tenantId, registerTypeId], references: [tenantId, id], onDelete: Restrict)
  owner              User?                   @relation("RegisterRecordOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  department         OrgDepartment?          @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Restrict)
  createdBy          User                    @relation("RegisterRecordCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy          User                    @relation("RegisterRecordUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  importBatch        ImportBatch?            @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@unique([tenantId, id])
  @@unique([tenantId, registerTypeId, businessRecordCode])
  @@index([tenantId, registerTypeId, deletedAt, dueDate])
  @@index([tenantId, registerTypeId, status])
  @@index([tenantId, ownerId])
  @@index([tenantId, departmentId])
  @@index([importBatchId])
  @@map("operational_register_records")
}

/// One workbook preview or commit attempt. `fileChecksum` detects a byte
/// identical workbook; `idempotencyKey` makes a repeated commit return the
/// original result instead of writing a second set of records.
model ImportBatch {
  id               String                      @id @default(uuid()) @db.Uuid
  tenantId         String                      @map("tenant_id") @db.Uuid
  originalFilename String                      @map("original_filename")
  fileChecksum     String                      @map("file_checksum")
  idempotencyKey   String                      @map("idempotency_key")
  status           ImportBatchStatus           @default(PREVIEWED)
  createdCount     Int                         @default(0) @map("created_count")
  updatedCount     Int                         @default(0) @map("updated_count")
  skippedCount     Int                         @default(0) @map("skipped_count")
  errorCount       Int                         @default(0) @map("error_count")
  uploadedById     String?                     @map("uploaded_by_id") @db.Uuid
  startedAt        DateTime                    @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt      DateTime?                   @map("completed_at") @db.Timestamptz(6)
  /// Per-sheet counts and the human readable summary, so a report can be
  /// re-read without replaying the workbook.
  report           Json                        @default("{}")
  createdAt        DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant           Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  uploadedBy       User?                       @relation("ImportBatchUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  rows             ImportBatchRow[]
  gaps             Gap[]
  capas            Capa[]
  registerRecords  OperationalRegisterRecord[]

  @@unique([tenantId, id])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, startedAt])
  @@index([tenantId, fileChecksum])
  @@map("import_batches")
}

model ImportBatchRow {
  id                  String          @id @default(uuid()) @db.Uuid
  tenantId            String          @map("tenant_id") @db.Uuid
  batchId             String          @map("batch_id") @db.Uuid
  sheet               String
  rowNumber           Int             @map("row_number")
  businessKey         String?         @map("business_key")
  normalizedPayload   Json            @default("{}") @map("normalized_payload")
  validationErrors    Json            @default("[]") @map("validation_errors")
  importResult        ImportRowResult @map("import_result")
  destinationTable    String?         @map("destination_table")
  destinationRecordId String?         @map("destination_record_id")
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  batch               ImportBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, batchId, sheet, rowNumber])
  @@index([tenantId, batchId, importResult])
  @@map("import_batch_rows")
}

enum ExternalConnectorType {
  CSV_FILE
  REST
  POSTGRES_READONLY
}

enum ExternalConnectionStatus {
  NOT_CONFIGURED
  CONFIGURED
  ERROR
  DISABLED
}

enum SyncRunStatus {
  PREVIEWED
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum ExternalMapStatus {
  ACTIVE
  CONFLICT
  DEACTIVATED
  INVALID
}

/// Configuration-driven connector to an external system such as GenRAC.
/// Secrets are referenced by environment key names — never stored here.
model ExternalSystemConnection {
  id                   String                  @id @default(uuid()) @db.Uuid
  tenantId             String                  @map("tenant_id") @db.Uuid
  systemCode           String                  @map("system_code")
  displayName          String                  @map("display_name")
  connectorType        ExternalConnectorType   @map("connector_type")
  status               ExternalConnectionStatus @default(NOT_CONFIGURED)
  /// Non-secret configuration (base URL host, mapping profile id, CSV path ref).
  config               Json                    @default("{}")
  /// Environment variable names that hold secrets — values are never returned.
  secretRefKeys        Json                    @default("[]") @map("secret_ref_keys")
  lastTestedAt         DateTime?               @map("last_tested_at") @db.Timestamptz(6)
  lastTestSuccess      Boolean?                @map("last_test_success")
  lastTestMessage      String?                 @map("last_test_message")
  lastSuccessfulSyncAt DateTime?               @map("last_successful_sync_at") @db.Timestamptz(6)
  lastAttemptedSyncAt  DateTime?               @map("last_attempted_sync_at") @db.Timestamptz(6)
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant               Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  recordMaps           ExternalRecordMap[]
  syncRuns             SyncRun[]

  @@unique([tenantId, id])
  @@unique([tenantId, systemCode])
  @@index([tenantId, status])
  @@map("external_system_connections")
}

model ExternalRecordMap {
  id                 String                  @id @default(uuid()) @db.Uuid
  tenantId           String                  @map("tenant_id") @db.Uuid
  connectionId       String                  @map("connection_id") @db.Uuid
  sourceEntityType   String                  @map("source_entity_type")
  externalRecordId   String                  @map("external_record_id")
  localEntityType    String                  @map("local_entity_type")
  localEntityId      String?                 @map("local_entity_id")
  sourceUpdatedAt    DateTime?               @map("source_updated_at") @db.Timestamptz(6)
  syncHash           String?                 @map("sync_hash")
  status             ExternalMapStatus       @default(ACTIVE)
  conflictReason     String?                 @map("conflict_reason")
  deactivatedAt      DateTime?               @map("deactivated_at") @db.Timestamptz(6)
  lastSyncedAt       DateTime?               @map("last_synced_at") @db.Timestamptz(6)
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant             Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  connection         ExternalSystemConnection @relation(fields: [tenantId, connectionId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id], map: "erm_tenant_id_id_key")
  @@unique([tenantId, connectionId, sourceEntityType, externalRecordId], map: "erm_conn_src_ext_uidx")
  @@index([tenantId, localEntityType, localEntityId], map: "erm_local_entity_idx")
  @@index([tenantId, status], map: "erm_tenant_status_idx")
  @@map("external_record_maps")
}

model SyncRun {
  id              String                  @id @default(uuid()) @db.Uuid
  tenantId        String                  @map("tenant_id") @db.Uuid
  connectionId    String                  @map("connection_id") @db.Uuid
  status          SyncRunStatus           @default(PREVIEWED)
  mode            String                  @default("PREVIEW")
  cursor          String?
  createCount     Int                     @default(0) @map("create_count")
  updateCount     Int                     @default(0) @map("update_count")
  conflictCount   Int                     @default(0) @map("conflict_count")
  invalidCount    Int                     @default(0) @map("invalid_count")
  skipCount       Int                     @default(0) @map("skip_count")
  errorSummary    Json                    @default("[]") @map("error_summary")
  report          Json                    @default("{}")
  startedAt       DateTime                @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt     DateTime?               @map("completed_at") @db.Timestamptz(6)
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  connection      ExternalSystemConnection @relation(fields: [tenantId, connectionId], references: [tenantId, id], onDelete: Restrict)
  items           SyncRunItem[]

  @@unique([tenantId, id])
  @@index([tenantId, connectionId, startedAt])
  @@index([tenantId, status, startedAt])
  @@map("sync_runs")
}

model SyncRunItem {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  syncRunId        String            @map("sync_run_id") @db.Uuid
  sourceEntityType String            @map("source_entity_type")
  externalRecordId String            @map("external_record_id")
  outcome          String
  message          String?
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  syncRun          SyncRun           @relation(fields: [tenantId, syncRunId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, syncRunId, outcome])
  @@map("sync_run_items")
}
