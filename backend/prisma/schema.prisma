generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecordStatus {
  ACTIVE
  DISABLED
  INVITED
  LOCKED
}

enum KpiDirection {
  HIGHER_IS_BETTER
  LOWER_IS_BETTER
  TARGET_EXACT
  INFORMATIONAL
}

enum KpiFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  ANNUAL
  CONTINUOUS
  PER_EVENT
  ONE_TIME
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum RagStatus {
  GREEN
  AMBER
  RED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  RESUBMITTED
}

enum KpiRiskClass {
  MAJOR
  MINOR
}

enum GeneralRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskStatus {
  OPEN
  UNDER_REVIEW
  TREATED
  CLOSED
  ARCHIVED
}

enum RiskTreatmentStrategy {
  AVOID
  MITIGATE
  TRANSFER
  ACCEPT
}

/// Chosen by this project, not taken from the client workbook. See
/// docs/reviews/risk-treatment-status-decision.md.
enum RiskTreatmentStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum GovernanceRecordStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum PolicyVersionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  SUPERSEDED
  OBSOLETE
}

enum ControlImplementationStatus {
  NOT_STARTED
  IN_PROGRESS
  PARTIALLY_IMPLEMENTED
  IMPLEMENTED
  NOT_APPLICABLE
}

enum ControlType {
  PREVENTIVE
  DETECTIVE
  CORRECTIVE
  DIRECTIVE
}

enum CheckpointOutcome {
  PASS
  PARTIAL
  FAIL
  NOT_APPLICABLE
}

enum EvidenceLifecycleStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  ARCHIVED
}

enum EvidenceDecisionOutcome {
  APPROVED
  REJECTED
}

/// Workbook `27_Lookups!Gap_Severity`. Distinct from KpiRiskClass and
/// GeneralRiskLevel: a Gap severity never becomes a Risk severity implicitly.
enum GapSeverity {
  CRITICAL
  MAJOR
  MINOR
  OBSERVATION
  OFI
}

enum GapStatus {
  OPEN
  IN_PROGRESS
  CLOSED
  CANCELLED
}

/// Workbook `27_Lookups!CAPA_Priority`.
enum CapaPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

/// Workbook `27_Lookups!CAPA_Status`.
enum CapaStatus {
  OPEN
  IN_PROGRESS
  PENDING_VERIFICATION
  CLOSED
  CANCELLED
}

enum ImportBatchStatus {
  PREVIEWED
  COMMITTING
  COMPLETED
  PARTIAL
  FAILED
}

enum ImportRowResult {
  CREATED
  UPDATED
  UNCHANGED
  SKIPPED
  FAILED
}

/// Separates history replayed from a client workbook from events this system
/// observed. Imported rows are never presented as first-party audit evidence.
/// EXTERNAL_SYNC records GenRAC connector activity without claiming live access.
enum AuditEventSource {
  SYSTEM
  IMPORT
  EXTERNAL_SYNC
}

model Tenant {
  id                       String                 @id @default(uuid()) @db.Uuid
  code                     String                 @unique
  name                     String
  industry                 String?
  country                  String?
  status                   RecordStatus           @default(ACTIVE)
  defaultAmberThresholdPct Decimal                @default(0.00) @map("default_amber_threshold_pct") @db.Decimal(6, 2)
  defaultRedThresholdPct   Decimal                @default(10.00) @map("default_red_threshold_pct") @db.Decimal(6, 2)
  nextRiskNumber           Int                    @default(1) @map("next_risk_number")
  nextKpiActualNumber      Int                    @default(1) @map("next_kpi_actual_number")
  nextPolicyNumber         Int                    @default(1) @map("next_policy_number")
  nextControlNumber        Int                    @default(1) @map("next_control_number")
  nextCheckpointNumber     Int                    @default(1) @map("next_checkpoint_number")
  nextEvidenceNumber       Int                    @default(1) @map("next_evidence_number")
  nextGapNumber            Int                    @default(1) @map("next_gap_number")
  nextCapaNumber           Int                    @default(1) @map("next_capa_number")
  createdAt                DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships              UserCompany[]
  defaultUsers             User[]                 @relation("DefaultTenant")
  roles                    Role[]
  userRoles                UserRole[]
  departments              OrgDepartment[]
  locations                OrgLocation[]
  units                    OrgUnit[]
  goals                    KpiGoal[]
  kpiConfigurations        KpiConfiguration[]
  kpiTargets               KpiTarget[]
  kpiActuals               KpiActual[]
  kpiApprovals             KpiApproval[]
  risks                    Risk[]
  riskReviews              RiskReview[]
  riskTreatments           RiskTreatment[]
  policies                 Policy[]
  policyVersions           PolicyVersion[]
  policyFrameworks         PolicyFramework[]
  policyApprovals          PolicyApproval[]
  controls                 Control[]
  controlPolicyVersions    ControlPolicyVersion[]
  controlFrameworks        ControlFramework[]
  ruleControls             RuleControl[]
  checkpoints              Checkpoint[]
  checkpointReviews        CheckpointReview[]
  evidence                 Evidence[]
  evidenceControlLinks     EvidenceControlLink[]
  evidenceCheckpointLinks  EvidenceCheckpointLink[]
  evidenceKpiActualLinks   EvidenceKpiActualLink[]
  evidenceReviewDecisions  EvidenceReviewDecision[]
  gaps                     Gap[]
  gapEvidenceLinks         GapEvidenceLink[]
  capas                    Capa[]
  capaEvidenceLinks        CapaEvidenceLink[]
  registerTypes            OperationalRegisterType[]
  registerRecords          OperationalRegisterRecord[]
  importBatches            ImportBatch[]
  importBatchRows          ImportBatchRow[]
  auditEvents              AuditEvent[]
  refreshTokens            RefreshToken[]
  externalConnections      ExternalSystemConnection[]
  externalRecordMaps       ExternalRecordMap[]
  syncRuns                 SyncRun[]

  @@map("tenants")
}

model User {
  id                        String                 @id @default(uuid()) @db.Uuid
  code                      String                 @unique
  email                     String                 @unique
  fullName                  String                 @map("full_name")
  phone                     String?
  passwordHash              String                 @map("password_hash")
  status                    RecordStatus           @default(ACTIVE)
  defaultTenantId           String?                @map("default_tenant_id") @db.Uuid
  failedLoginCount          Int                    @default(0) @map("failed_login_count")
  lockedUntil               DateTime?              @map("locked_until") @db.Timestamptz(6)
  lastLoginAt               DateTime?              @map("last_login_at") @db.Timestamptz(6)
  createdAt                 DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships               UserCompany[]
  defaultTenant             Tenant?                @relation("DefaultTenant", fields: [defaultTenantId], references: [id], onDelete: SetNull)
  roles                     UserRole[]             @relation("UserRoles")
  rolesAssigned             UserRole[]             @relation("AssignedRoles")
  refreshTokens             RefreshToken[]
  auditEvents               AuditEvent[]
  ownedKpiConfigurations    KpiConfiguration[]     @relation("KpiConfigurationOwner")
  approverKpiConfigurations KpiConfiguration[]     @relation("KpiConfigurationApprover")
  createdKpiConfigurations  KpiConfiguration[]     @relation("KpiConfigurationCreatedBy")
  updatedKpiConfigurations  KpiConfiguration[]     @relation("KpiConfigurationUpdatedBy")
  submittedKpiTargets       KpiTarget[]            @relation("KpiTargetSubmittedBy")
  approvedKpiTargets        KpiTarget[]            @relation("KpiTargetApprovedBy")
  createdKpiTargets         KpiTarget[]            @relation("KpiTargetCreatedBy")
  updatedKpiTargets         KpiTarget[]            @relation("KpiTargetUpdatedBy")
  submittedKpiActuals       KpiActual[]            @relation("KpiActualSubmittedBy")
  approvedKpiActuals        KpiActual[]            @relation("KpiActualApprovedBy")
  createdKpiActuals         KpiActual[]            @relation("KpiActualCreatedBy")
  updatedKpiActuals         KpiActual[]            @relation("KpiActualUpdatedBy")
  reviewedKpiActuals        KpiApproval[]          @relation("KpiApprovalReviewer")
  ownedRisks                Risk[]                 @relation("RiskOwner")
  createdRisks              Risk[]                 @relation("RiskCreatedBy")
  updatedRisks              Risk[]                 @relation("RiskUpdatedBy")
  reviewedRisks             RiskReview[]           @relation("RiskReviewReviewer")
  ownedRiskTreatments       RiskTreatment[]        @relation("RiskTreatmentOwner")
  recordedRiskTreatments    RiskTreatment[]        @relation("RiskTreatmentRecordedBy")
  ownedPolicies             Policy[]               @relation("PolicyOwner")
  createdPolicies           Policy[]               @relation("PolicyCreatedBy")
  updatedPolicies           Policy[]               @relation("PolicyUpdatedBy")
  requestedPolicyVersions   PolicyVersion[]        @relation("PolicyVersionRequestedApprover")
  submittedPolicyVersions   PolicyVersion[]        @relation("PolicyVersionSubmittedBy")
  approvedPolicyVersions    PolicyVersion[]        @relation("PolicyVersionApprovedBy")
  createdPolicyVersions     PolicyVersion[]        @relation("PolicyVersionCreatedBy")
  updatedPolicyVersions     PolicyVersion[]        @relation("PolicyVersionUpdatedBy")
  createdPolicyFrameworks   PolicyFramework[]      @relation("PolicyFrameworkCreatedBy")
  updatedPolicyFrameworks   PolicyFramework[]      @relation("PolicyFrameworkUpdatedBy")
  policyApprovalActions     PolicyApproval[]       @relation("PolicyApprovalActor")
  ownedControls             Control[]              @relation("ControlOwner")
  createdControls           Control[]              @relation("ControlCreatedBy")
  updatedControls           Control[]              @relation("ControlUpdatedBy")
  createdControlPolicies    ControlPolicyVersion[] @relation("ControlPolicyVersionCreatedBy")
  updatedControlPolicies    ControlPolicyVersion[] @relation("ControlPolicyVersionUpdatedBy")
  createdControlFrameworks  ControlFramework[]     @relation("ControlFrameworkCreatedBy")
  updatedControlFrameworks  ControlFramework[]     @relation("ControlFrameworkUpdatedBy")
  createdRuleControls       RuleControl[]          @relation("RuleControlCreatedBy")
  updatedRuleControls       RuleControl[]          @relation("RuleControlUpdatedBy")
  ownedCheckpoints          Checkpoint[]           @relation("CheckpointOwner")
  createdCheckpoints        Checkpoint[]           @relation("CheckpointCreatedBy")
  updatedCheckpoints        Checkpoint[]           @relation("CheckpointUpdatedBy")
  checkpointReviews         CheckpointReview[]     @relation("CheckpointReviewReviewer")
  ownedEvidence             Evidence[]             @relation("EvidenceOwner")
  createdEvidence           Evidence[]             @relation("EvidenceCreatedBy")
  updatedEvidence           Evidence[]             @relation("EvidenceUpdatedBy")
  submittedEvidence         Evidence[]             @relation("EvidenceSubmittedBy")
  reviewedEvidence          Evidence[]             @relation("EvidenceReviewedBy")
  uploadedEvidence          Evidence[]             @relation("EvidenceUploadedBy")
  evidenceReviewActions     EvidenceReviewDecision[] @relation("EvidenceReviewActor")
  createdEvidenceControlLinks EvidenceControlLink[] @relation("EvidenceControlLinkCreatedBy")
  updatedEvidenceControlLinks EvidenceControlLink[] @relation("EvidenceControlLinkUpdatedBy")
  createdEvidenceCheckpointLinks EvidenceCheckpointLink[] @relation("EvidenceCheckpointLinkCreatedBy")
  updatedEvidenceCheckpointLinks EvidenceCheckpointLink[] @relation("EvidenceCheckpointLinkUpdatedBy")
  createdEvidenceKpiActualLinks EvidenceKpiActualLink[] @relation("EvidenceKpiActualLinkCreatedBy")
  updatedEvidenceKpiActualLinks EvidenceKpiActualLink[] @relation("EvidenceKpiActualLinkUpdatedBy")
  ownedGaps                 Gap[]                  @relation("GapOwner")
  createdGaps               Gap[]                  @relation("GapCreatedBy")
  updatedGaps               Gap[]                  @relation("GapUpdatedBy")
  createdGapEvidenceLinks   GapEvidenceLink[]      @relation("GapEvidenceLinkCreatedBy")
  updatedGapEvidenceLinks   GapEvidenceLink[]      @relation("GapEvidenceLinkUpdatedBy")
  ownedCapas                Capa[]                 @relation("CapaOwner")
  createdCapas              Capa[]                 @relation("CapaCreatedBy")
  updatedCapas              Capa[]                 @relation("CapaUpdatedBy")
  createdCapaEvidenceLinks  CapaEvidenceLink[]     @relation("CapaEvidenceLinkCreatedBy")
  updatedCapaEvidenceLinks  CapaEvidenceLink[]     @relation("CapaEvidenceLinkUpdatedBy")
  ownedRegisterRecords      OperationalRegisterRecord[] @relation("RegisterRecordOwner")
  createdRegisterRecords    OperationalRegisterRecord[] @relation("RegisterRecordCreatedBy")
  updatedRegisterRecords    OperationalRegisterRecord[] @relation("RegisterRecordUpdatedBy")
  startedImportBatches      ImportBatch[]          @relation("ImportBatchUploadedBy")

  @@index([status, createdAt])
  @@map("users")
}

model UserCompany {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  departmentId String?        @map("department_id") @db.Uuid
  status       RecordStatus   @default(ACTIVE)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department   OrgDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([userId, tenantId])
  @@index([tenantId, status])
  @@index([departmentId])
  @@map("user_companies")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String
  name        String
  description String?
  tenantId    String           @map("tenant_id") @db.Uuid
  status      RecordStatus     @default(ACTIVE)
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       UserRole[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  name        String
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  roleId     String       @map("role_id") @db.Uuid
  tenantId   String       @map("tenant_id") @db.Uuid
  status     RecordStatus @default(ACTIVE)
  assignedBy String?      @map("assigned_by") @db.Uuid
  assignedAt DateTime     @default(now()) @map("assigned_at") @db.Timestamptz(6)
  user       User         @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role       Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assigner   User?        @relation("AssignedRoles", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@unique([userId, roleId, tenantId])
  @@index([tenantId, status])
  @@map("user_roles")
}

model OrgDepartment {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  code              String
  name              String
  headName          String?            @map("head_name")
  status            RecordStatus       @default(ACTIVE)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships       UserCompany[]
  kpiConfigurations KpiConfiguration[]
  policies          Policy[]
  controls          Control[]
  checkpoints       Checkpoint[]
  evidence          Evidence[]
  gaps              Gap[]
  capas             Capa[]
  registerRecords   OperationalRegisterRecord[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt])
  @@map("org_departments")
}

model OrgLocation {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  code              String
  name              String
  city              String?
  state             String?
  country           String?
  type              String?
  status            RecordStatus       @default(ACTIVE)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kpiConfigurations KpiConfiguration[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt])
  @@map("org_locations")
}

model OrgUnit {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  code              String
  name              String
  status            RecordStatus       @default(ACTIVE)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kpiConfigurations KpiConfiguration[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt])
  @@map("org_units")
}

model Framework {
  id                String             @id @default(uuid()) @db.Uuid
  code              String
  name              String
  version           String
  description       String?
  status            RecordStatus       @default(ACTIVE)
  /// Verbatim client vocabulary from `27_Lookups!Compliance_Status`, for
  /// example `Certified` or `Active – Out of Scope`. `status` stays the
  /// coarse ACTIVE/DISABLED switch the rest of the platform filters on.
  scopeStatus       String?            @map("scope_status")
  rules             FrameworkRule[]
  policyFrameworks  PolicyFramework[]
  controlFrameworks ControlFramework[]
  gaps              Gap[]
  capas             Capa[]

  @@unique([code, version])
  @@index([status, name])
  @@map("frameworks")
}

model FrameworkRule {
  id           String        @id @default(uuid()) @db.Uuid
  frameworkId  String        @map("framework_id") @db.Uuid
  code         String
  title        String
  description  String?
  status       RecordStatus  @default(ACTIVE)
  /// Clause or control reference as written by the framework body, for
  /// example `A.5.15` or `§164.308(a)(1)`. `code` stays the workbook checkpoint
  /// identifier so a revised workbook still upserts onto the same row.
  clauseRef    String?       @map("clause_ref")
  theme        String?
  criticality  String?
  frequency    String?
  framework    Framework     @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  ruleControls RuleControl[]
  gaps         Gap[]

  @@unique([frameworkId, code])
  @@unique([frameworkId, id])
  @@index([frameworkId, status])
  @@map("framework_rules")
}

model Policy {
  id                       String                 @id @default(uuid()) @db.Uuid
  tenantId                 String                 @map("tenant_id") @db.Uuid
  code                     String
  title                    String
  description              String?                @db.Text
  ownerId                  String?                @map("owner_id") @db.Uuid
  departmentId             String?                @map("department_id") @db.Uuid
  lifecycleStatus          GovernanceRecordStatus @default(ACTIVE) @map("lifecycle_status")
  currentApprovedVersionId String?                @map("current_approved_version_id") @db.Uuid
  nextVersionSequence      Int                    @default(1) @map("next_version_sequence")
  createdById              String                 @map("created_by_id") @db.Uuid
  updatedById              String                 @map("updated_by_id") @db.Uuid
  createdAt                DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt               DateTime?              @map("archived_at") @db.Timestamptz(6)
  tenant                   Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  owner                    User?                  @relation("PolicyOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  department               OrgDepartment?         @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Restrict)
  currentApprovedVersion   PolicyVersion?         @relation("PolicyCurrentApprovedVersion", fields: [tenantId, id, currentApprovedVersionId], references: [tenantId, policyId, id], onDelete: Restrict)
  versions                 PolicyVersion[]        @relation("PolicyVersions")
  createdBy                User                   @relation("PolicyCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy                User                   @relation("PolicyUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, id, currentApprovedVersionId])
  @@unique([tenantId, code])
  @@index([tenantId, lifecycleStatus, archivedAt])
  @@index([tenantId, ownerId])
  @@index([tenantId, departmentId])
  @@index([currentApprovedVersionId])
  @@map("policies")
}

model PolicyVersion {
  id                  String                 @id @default(uuid()) @db.Uuid
  tenantId            String                 @map("tenant_id") @db.Uuid
  policyId            String                 @map("policy_id") @db.Uuid
  sequence            Int
  versionMajor        Int                    @map("version_major")
  versionMinor        Int                    @map("version_minor")
  content             String                 @db.Text
  purpose             String?                @db.Text
  scope               String?                @db.Text
  changeSummary       String?                @map("change_summary") @db.Text
  status              PolicyVersionStatus    @default(DRAFT)
  effectiveDate       DateTime?              @map("effective_date") @db.Date
  reviewDate          DateTime?              @map("review_date") @db.Date
  requiresEvidence    Boolean                @default(false) @map("requires_evidence")
  requestedApproverId String?                @map("requested_approver_id") @db.Uuid
  submittedById       String?                @map("submitted_by_id") @db.Uuid
  submittedAt         DateTime?              @map("submitted_at") @db.Timestamptz(6)
  approvedById        String?                @map("approved_by_id") @db.Uuid
  approvedAt          DateTime?              @map("approved_at") @db.Timestamptz(6)
  supersededById      String?                @map("superseded_by_id") @db.Uuid
  createdById         String                 @map("created_by_id") @db.Uuid
  updatedById         String                 @map("updated_by_id") @db.Uuid
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant              Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  policy              Policy                 @relation("PolicyVersions", fields: [tenantId, policyId], references: [tenantId, id], onDelete: Restrict)
  currentForPolicy    Policy?                @relation("PolicyCurrentApprovedVersion")
  requestedApprover   User?                  @relation("PolicyVersionRequestedApprover", fields: [requestedApproverId], references: [id], onDelete: Restrict)
  submittedBy         User?                  @relation("PolicyVersionSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  approvedBy          User?                  @relation("PolicyVersionApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  createdBy           User                   @relation("PolicyVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy           User                   @relation("PolicyVersionUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  supersededBy        PolicyVersion?         @relation("PolicyVersionSupersession", fields: [tenantId, policyId, supersededById], references: [tenantId, policyId, id], onDelete: Restrict)
  supersedes          PolicyVersion[]        @relation("PolicyVersionSupersession")
  frameworkMappings   PolicyFramework[]
  approvals           PolicyApproval[]
  controlMappings     ControlPolicyVersion[]

  @@unique([tenantId, id])
  @@unique([tenantId, policyId, id])
  @@unique([tenantId, policyId, sequence])
  @@unique([tenantId, policyId, versionMajor, versionMinor])
  @@index([tenantId, policyId, status, sequence])
  @@index([requestedApproverId])
  @@index([submittedById])
  @@index([approvedById])
  @@index([supersededById])
  @@map("policy_versions")
}

model PolicyFramework {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  policyId        String        @map("policy_id") @db.Uuid
  policyVersionId String        @map("policy_version_id") @db.Uuid
  frameworkId     String        @map("framework_id") @db.Uuid
  isActive        Boolean       @default(true) @map("is_active")
  createdById     String        @map("created_by_id") @db.Uuid
  updatedById     String        @map("updated_by_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  version         PolicyVersion @relation(fields: [tenantId, policyId, policyVersionId], references: [tenantId, policyId, id], onDelete: Restrict)
  framework       Framework     @relation(fields: [frameworkId], references: [id], onDelete: Restrict)
  createdBy       User          @relation("PolicyFrameworkCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy       User          @relation("PolicyFrameworkUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, policyVersionId, frameworkId])
  @@index([tenantId, policyId, policyVersionId, isActive])
  @@index([frameworkId, isActive])
  @@map("policy_frameworks")
}

model PolicyApproval {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  policyId        String           @map("policy_id") @db.Uuid
  policyVersionId String           @map("policy_version_id") @db.Uuid
  actedById       String           @map("acted_by_id") @db.Uuid
  decision        ApprovalDecision
  comments        String?          @db.Text
  decidedAt       DateTime         @default(now()) @map("decided_at") @db.Timestamptz(6)
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  version         PolicyVersion    @relation(fields: [tenantId, policyId, policyVersionId], references: [tenantId, policyId, id], onDelete: Restrict)
  actedBy         User             @relation("PolicyApprovalActor", fields: [actedById], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, policyVersionId, decidedAt])
  @@index([tenantId, actedById, decidedAt])
  @@map("policy_approvals")
}

model Control {
  id                    String                      @id @default(uuid()) @db.Uuid
  tenantId              String                      @map("tenant_id") @db.Uuid
  code                  String
  title                 String
  description           String?                     @db.Text
  objective             String                      @db.Text
  ownerId               String?                     @map("owner_id") @db.Uuid
  departmentId          String?                     @map("department_id") @db.Uuid
  implementationStatus  ControlImplementationStatus @default(NOT_STARTED) @map("implementation_status")
  implementationNotes   String?                     @map("implementation_notes") @db.Text
  controlType           ControlType                 @map("control_type")
  frequency             KpiFrequency
  verificationMethod    String                      @map("verification_method") @db.Text
  requiresEvidence      Boolean                     @default(false) @map("requires_evidence")
  lifecycleStatus       GovernanceRecordStatus      @default(ACTIVE) @map("lifecycle_status")
  lastReviewDate        DateTime?                   @map("last_review_date") @db.Date
  nextReviewDate        DateTime?                   @map("next_review_date") @db.Date
  createdById           String                      @map("created_by_id") @db.Uuid
  updatedById           String                      @map("updated_by_id") @db.Uuid
  createdAt             DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt            DateTime?                   @map("archived_at") @db.Timestamptz(6)
  tenant                Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  owner                 User?                       @relation("ControlOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  department            OrgDepartment?              @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Restrict)
  createdBy             User                        @relation("ControlCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy             User                        @relation("ControlUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  policyVersionMappings ControlPolicyVersion[]
  frameworkMappings     ControlFramework[]
  checkpoints           Checkpoint[]
  evidenceLinks         EvidenceControlLink[]
  gaps                  Gap[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, lifecycleStatus, implementationStatus])
  @@index([tenantId, ownerId])
  @@index([tenantId, departmentId])
  @@index([tenantId, nextReviewDate])
  @@map("controls")
}

