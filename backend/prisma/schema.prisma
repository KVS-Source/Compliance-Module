/// Append-only review ledger. The `risk_reviews_append_only` trigger rejects
/// UPDATE and DELETE, so a recorded review stands as written.
model RiskReview {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  riskId             String   @map("risk_id") @db.Uuid
  reviewerId         String?  @map("reviewer_id") @db.Uuid
  comments           String
  likelihoodAtReview Int?     @map("likelihood_at_review")
  impactAtReview     Int?     @map("impact_at_review")
  reviewedAt         DateTime @default(now()) @map("reviewed_at") @db.Timestamptz(6)
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  risk               Risk     @relation(fields: [tenantId, riskId], references: [tenantId, id], onDelete: Restrict)
  reviewer           User?    @relation("RiskReviewReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, riskId, reviewedAt])
  @@index([tenantId, reviewerId, reviewedAt])
  @@map("risk_reviews")
}

/// Append-only treatment ledger. Rows are immutable: completing a treatment
/// inserts a new COMPLETED row rather than editing the original, so the
/// current treatment is the latest row. The `risk_treatments_append_only`
/// trigger rejects UPDATE and DELETE.
model RiskTreatment {
  id                 String                @id @default(uuid()) @db.Uuid
  tenantId           String                @map("tenant_id") @db.Uuid
  riskId             String                @map("risk_id") @db.Uuid
  strategy           RiskTreatmentStrategy
  plan               String
  ownerId            String?               @map("owner_id") @db.Uuid
  dueDate            DateTime?             @map("due_date") @db.Date
  completedAt        DateTime?             @map("completed_at") @db.Timestamptz(6)
  status             RiskTreatmentStatus   @default(PLANNED)
  effectivenessNotes String?               @map("effectiveness_notes")
  supersedesId       String?               @map("supersedes_id") @db.Uuid
  recordedById       String                @map("recorded_by_id") @db.Uuid
  recordedAt         DateTime              @default(now()) @map("recorded_at") @db.Timestamptz(6)
  tenant             Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  risk               Risk                  @relation(fields: [tenantId, riskId], references: [tenantId, id], onDelete: Restrict)
  owner              User?                 @relation("RiskTreatmentOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  recordedBy         User                  @relation("RiskTreatmentRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  supersedes         RiskTreatment?        @relation("RiskTreatmentSupersedes", fields: [tenantId, supersedesId], references: [tenantId, id], onDelete: Restrict)
  supersededBy       RiskTreatment[]       @relation("RiskTreatmentSupersedes")

  @@unique([tenantId, id])
  @@index([tenantId, riskId, recordedAt])
  @@index([tenantId, ownerId, status])
  @@map("risk_treatments")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  userId     String    @map("user_id") @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  familyId   String    @map("family_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedBy String?   @map("replaced_by") @db.Uuid
  /// Client address observed when the session was issued or last rotated.
  /// Nullable for tokens created before session management shipped.
  ipAddress  String?   @map("ip_address")
  /// User-Agent string captured at issue/rotate. Not parsed into a device
  /// catalogue — the raw value is enough for an administrator to recognise a
  /// browser. Nullable for tokens created before session management shipped.
  userAgent  String?   @map("user_agent") @db.Text
  /// Updated on every successful refresh rotation so "last used" is real.
  lastUsedAt DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@index([tenantId, expiresAt])
  @@index([userId, tenantId, revokedAt])
  @@map("refresh_tokens")
}

model AuditEvent {
  id         String           @id @default(uuid()) @db.Uuid
  tenantId   String           @map("tenant_id") @db.Uuid
  userId     String?          @map("user_id") @db.Uuid
  action     String
  entityType String           @map("entity_type")
  entityId   String?          @map("entity_id")
  metadata   Json             @default("{}")
  ipAddress  String?          @map("ip_address")
  userAgent  String?          @map("user_agent")
  /// SYSTEM for events this platform observed, IMPORT for history replayed
  /// from a client workbook. `createdAt` is always the time this row was
  /// written; an imported event carries its original stamp in `metadata`.
  source     AuditEventSource @default(SYSTEM)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user       User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, action])
  @@index([tenantId, source, createdAt])
  @@map("audit_events")
}

/// A control weakness raised against a framework clause, control or
/// checkpoint. Workbook source: `10_Gap_Analysis`.
model Gap {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  code            String
  title           String
  description     String?           @db.Text
  source          String?
  frameworkId     String?           @map("framework_id") @db.Uuid
  frameworkRuleId String?           @map("framework_rule_id") @db.Uuid
  controlId       String?           @map("control_id") @db.Uuid
  checkpointId    String?           @map("checkpoint_id") @db.Uuid
  clauseRef       String?           @map("clause_ref")
  recommendedAction String?         @map("recommended_action") @db.Text
  severity        GapSeverity
  status          GapStatus         @default(OPEN)
  ownerId         String?           @map("owner_id") @db.Uuid
  /// Workbook owner token such as `U-004`. Imported rows keep the client's
  /// reference without provisioning an authenticated account for it.
  sourceOwnerRef  String?           @map("source_owner_ref")
  departmentId    String?           @map("department_id") @db.Uuid
  identifiedOn    DateTime?         @map("identified_on") @db.Date
  dueDate         DateTime?         @map("due_date") @db.Date
  closedAt        DateTime?         @map("closed_at") @db.Timestamptz(6)
  closureNote     String?           @map("closure_note") @db.Text
  /// Set when the value could not be derived from the workbook and a
  /// documented fallback was applied. Surfaced for human review.
  needsReview     Boolean           @default(false) @map("needs_review")
  reviewReason    String?           @map("review_reason")
  importBatchId   String?           @map("import_batch_id") @db.Uuid
  sourceSheet     String?           @map("source_sheet")
  sourceRow       Int?              @map("source_row")
  createdById     String            @map("created_by_id") @db.Uuid
  updatedById     String            @map("updated_by_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?         @map("deleted_at") @db.Timestamptz(6)
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  framework       Framework?        @relation(fields: [frameworkId], references: [id], onDelete: Restrict)
  frameworkRule   FrameworkRule?    @relation(fields: [frameworkRuleId], references: [id], onDelete: Restrict)
  control         Control?          @relation(fields: [tenantId, controlId], references: [tenantId, id], onDelete: Restrict)
  checkpoint      Checkpoint?       @relation(fields: [tenantId, checkpointId], references: [tenantId, id], onDelete: Restrict)
  owner           User?             @relation("GapOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  department      OrgDepartment?    @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Restrict)
  createdBy       User              @relation("GapCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy       User              @relation("GapUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  importBatch     ImportBatch?      @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  capas           Capa[]
  evidenceLinks   GapEvidenceLink[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, status, deletedAt, dueDate])
  @@index([tenantId, severity, status, deletedAt])
  @@index([tenantId, ownerId])
  @@index([tenantId, departmentId])
  @@index([tenantId, frameworkId])
  @@index([frameworkRuleId])
  @@index([tenantId, controlId])
  @@index([tenantId, checkpointId])
  @@index([importBatchId])
  @@map("gaps")
}

model GapEvidenceLink {
