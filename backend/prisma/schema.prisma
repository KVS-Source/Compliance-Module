generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecordStatus {
  ACTIVE
  DISABLED
  INVITED
  LOCKED
}

model Tenant {
  id            String          @id @default(uuid()) @db.Uuid
  code          String          @unique
  name          String
  industry      String?
  country       String?
  status        RecordStatus    @default(ACTIVE)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships   UserCompany[]
  defaultUsers  User[]          @relation("DefaultTenant")
  roles         Role[]
  userRoles     UserRole[]
  departments   OrgDepartment[]
  locations     OrgLocation[]
  units         OrgUnit[]
  goals         KpiGoal[]
  auditEvents   AuditEvent[]
  refreshTokens RefreshToken[]

  @@map("tenants")
}

model User {
  id               String         @id @default(uuid()) @db.Uuid
  code             String         @unique
  email            String         @unique
  fullName         String         @map("full_name")
  phone            String?
  passwordHash     String         @map("password_hash")
  status           RecordStatus   @default(ACTIVE)
  defaultTenantId  String?        @map("default_tenant_id") @db.Uuid
  failedLoginCount Int            @default(0) @map("failed_login_count")
  lockedUntil      DateTime?      @map("locked_until") @db.Timestamptz(6)
  lastLoginAt      DateTime?      @map("last_login_at") @db.Timestamptz(6)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships      UserCompany[]
  defaultTenant    Tenant?        @relation("DefaultTenant", fields: [defaultTenantId], references: [id], onDelete: SetNull)
  roles            UserRole[]     @relation("UserRoles")
  rolesAssigned    UserRole[]     @relation("AssignedRoles")
  refreshTokens    RefreshToken[]
  auditEvents      AuditEvent[]

  @@index([status, createdAt])
  @@map("users")
}

model UserCompany {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  departmentId String?        @map("department_id") @db.Uuid
  status       RecordStatus   @default(ACTIVE)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department   OrgDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([userId, tenantId])
  @@index([tenantId, status])
  @@index([departmentId])
  @@map("user_companies")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String
  name        String
  description String?
  tenantId    String           @map("tenant_id") @db.Uuid
  status      RecordStatus     @default(ACTIVE)
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       UserRole[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  name        String
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  roleId     String       @map("role_id") @db.Uuid
  tenantId   String       @map("tenant_id") @db.Uuid
  status     RecordStatus @default(ACTIVE)
  assignedBy String?      @map("assigned_by") @db.Uuid
  assignedAt DateTime     @default(now()) @map("assigned_at") @db.Timestamptz(6)
  user       User         @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role       Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assigner   User?        @relation("AssignedRoles", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@unique([userId, roleId, tenantId])
  @@index([tenantId, status])
  @@map("user_roles")
}

model OrgDepartment {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  code        String
  name        String
  headName    String?       @map("head_name")
  status      RecordStatus  @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships UserCompany[]

  @@unique([tenantId, code])
  @@index([tenantId, status, createdAt])
  @@map("org_departments")
}

model OrgLocation {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  code      String
  name      String
  city      String?
  state     String?
  country   String?
  type      String?
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, status, createdAt])
  @@map("org_locations")
}

model OrgUnit {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  code      String
  name      String
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, status, createdAt])
  @@map("org_units")
}

model Framework {
  id          String          @id @default(uuid()) @db.Uuid
  code        String
  name        String
  version     String
  description String?
  status      RecordStatus    @default(ACTIVE)
  rules       FrameworkRule[]

  @@unique([code, version])
  @@index([status, name])
  @@map("frameworks")
}

model FrameworkRule {
  id          String       @id @default(uuid()) @db.Uuid
  frameworkId String       @map("framework_id") @db.Uuid
  code        String
  title       String
  description String?
  status      RecordStatus @default(ACTIVE)
  framework   Framework    @relation(fields: [frameworkId], references: [id], onDelete: Cascade)

  @@unique([frameworkId, code])
  @@index([frameworkId, status])
  @@map("framework_rules")
}

model KpiDefinition {
  id          String       @id @default(uuid()) @db.Uuid
  code        String       @unique
  name        String
  description String?
  unit        String
  direction   String
  frequency   String
  status      RecordStatus @default(ACTIVE)
  goals       KpiGoal[]

  @@index([status, name])
  @@map("kpi_definitions")
}

model KpiGoal {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  kpiDefinitionId String        @map("kpi_definition_id") @db.Uuid
  code            String
  targetValue     Decimal       @map("target_value") @db.Decimal(18, 4)
  warningValue    Decimal?      @map("warning_value") @db.Decimal(18, 4)
  criticalValue   Decimal?      @map("critical_value") @db.Decimal(18, 4)
  period          String
  effectiveFrom   DateTime      @map("effective_from") @db.Date
  effectiveTo     DateTime?     @map("effective_to") @db.Date
  status          RecordStatus  @default(ACTIVE)
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  definition      KpiDefinition @relation(fields: [kpiDefinitionId], references: [id], onDelete: Restrict)

  @@unique([tenantId, code])
  @@index([tenantId, status, effectiveFrom])
  @@map("kpi_goals")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  userId     String    @map("user_id") @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  familyId   String    @map("family_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedBy String?   @map("replaced_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@index([tenantId, expiresAt])
  @@map("refresh_tokens")
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json     @default("{}")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, action])
  @@map("audit_events")
}
