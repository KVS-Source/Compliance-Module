{
  "name": "genbioca-compliance-milestone-1",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run tests/unit.test.ts tests/environment.test.ts tests/test-database.test.ts tests/auth-logout.test.ts tests/health.test.ts tests/frontend-serving.test.ts tests/hardening.test.ts tests/logger-redaction.test.ts tests/kpi-management-unit.test.ts tests/kpi-performance-unit.test.ts tests/kpi-approval-unit.test.ts tests/risk-service-unit.test.ts tests/governance-domain-unit.test.ts",
    "test:integration": "tsx scripts/run-integration-tests.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed:dev": "tsx prisma/seed.ts --development",
    "prisma:seed:test": "tsx prisma/seed.ts --test-fixture",
    "seed:demo": "tsx prisma/demo-seed.ts",
    "start:docker": "node dist/src/server.js"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.15",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.31.0",
    "prettier": "^3.6.2",
    "prisma": "^6.12.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  }
}
