# Dependencies
node_modules/

# Build output
dist/
**/dist/
build/
**/coverage/

# Env and secrets — never commit real values
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.p12
*.pfx
credentials*.json
service-account*.json

# Uploaded files (local dev storage)
uploads/*
!uploads/.gitkeep
**/uploads/*
!**/uploads/.gitkeep

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test / coverage / Playwright
coverage/
.vitest/
test-results/
**/test-results/
playwright-report/
**/playwright-report/
blob-report/
**/blob-report/

# Prisma local db
prisma/*.db
**/prisma/*.db
*.sqlite
*.sqlite3

# Database dumps
*.dump
*.backup
*.sql.gz

# Local review, cache, and presentation artifacts
.ppt_staging/
outputs/
.tmp/
.cache/
.turbo/
*.tsbuildinfo
gitleaks-report.json

# OS / editor noise
.DS_Store
**/.DS_Store
Thumbs.db
.idea/
CLAUDE.md
AGENTS.md
.cursor/
.claude/
.vscode/
*.swp
*~

# Legacy Python backend leftovers (the folder itself is preserved under legacy/)
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
storage/
