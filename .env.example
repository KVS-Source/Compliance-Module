# Runtime mode
NODE_ENV=development
PORT=8000

# Local backend database connection. Replace every bracketed placeholder.
DATABASE_URL=postgresql://<development-user>:<development-password>@127.0.0.1:5432/<development-database>?schema=public

# Docker application database connection. The hostname is normally `postgres`.
DOCKER_DATABASE_URL=postgresql://<development-user>:<development-password>@postgres:5432/<development-database>?schema=public
POSTGRES_DB=<development-database>
POSTGRES_USER=<development-user>
POSTGRES_PASSWORD=<development-password>
POSTGRES_PORT=5432

# Isolated integration-test database. Its name must clearly contain `test`.
DATABASE_URL_TEST=postgresql://<test-user>:<test-password>@127.0.0.1:5433/<test-database-name>?schema=public
TEST_POSTGRES_DB=<test-database-name>
TEST_POSTGRES_USER=<test-user>
TEST_POSTGRES_PASSWORD=<test-password>
TEST_POSTGRES_PORT=5433

# Authentication. Use a generated secret of at least 32 characters.
JWT_ACCESS_SECRET=<generate-a-strong-random-secret>
JWT_ACCESS_TTL=15m
JWT_ISSUER=genbioca-compliance
REFRESH_TOKEN_DAYS=7

# Must be true whenever NODE_ENV=production.
COOKIE_SECURE=false

# Number of reverse proxies in front of the app, or false when it is exposed
# directly. This decides req.ip, which keys rate limiting and audit records.
# `true` is rejected in production because it lets clients forge X-Forwarded-For.
TRUST_PROXY=false

# Request throttling. The window is shared by all three ceilings.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_API_MAX=600
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_REFRESH_MAX=60
# Test-suite escape hatch only; rejected when NODE_ENV=production.
RATE_LIMIT_DISABLED=false

# Application paths and logging
FRONTEND_DIST=../frontend/dist
PROTOTYPE_DIR=../docs/prototype
FILE_STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads
# Evidence upload limits (bytes / rate). Allowlists remain code-controlled.
EVIDENCE_MAX_UPLOAD_BYTES=10485760
EVIDENCE_UPLOAD_RATE_MAX=20
EVIDENCE_UPLOAD_RATE_WINDOW_MS=900000
LOG_LEVEL=info

# Explicit non-production UAT/demo seed only. Supply the password at command
# execution time; never commit a real value. Production always rejects the seed.
DEMO_SEED_PASSWORD=<set-a-strong-local-or-uat-password>

# S3 is recognised but unimplemented. Selecting FILE_STORAGE_DRIVER=s3 fails
# configuration closed; these placeholders are retained for a later milestone.
# S3_ENDPOINT=https://s3.example.test
# S3_BUCKET=<evidence-bucket>
