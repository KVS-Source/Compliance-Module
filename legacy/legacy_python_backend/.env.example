APP_NAME=GenBioCa GRC API
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/genbioca_grc
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
LOCAL_STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=25
SEED_ON_STARTUP=true
ALLOWED_ORIGINS=http://localhost:3000

# Optional first tenant/admin. Remove these after the first successful seed.
BOOTSTRAP_CLIENT_SLUG=demo
BOOTSTRAP_CLIENT_NAME=Demo Client
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-10-characters
BOOTSTRAP_PLATFORM_ADMIN=true

# Optional GenBioCa development-demo passwords used by `python -m app.demo_seed`.
# These defaults are development-only. Change them before sharing an environment.
DEMO_ADMIN_PASSWORD=ChangeMe-Admin-2026!
DEMO_COMPLIANCE_PASSWORD=ChangeMe-Compliance-2026!
DEMO_KPI_OWNER_PASSWORD=ChangeMe-KPI-2026!
DEMO_HR_PASSWORD=ChangeMe-HR-2026!
