# Copy to an untracked deployment environment file and replace every bracketed
# placeholder. Never commit the populated file.
NODE_ENV=production
PORT=8000
POSTGRES_DB=<database-name>
POSTGRES_USER=<database-user>
POSTGRES_PASSWORD=<generate-a-strong-database-password>
DATABASE_URL=postgresql://<database-user>:<database-password>@postgres:5432/<database-name>?schema=public

# Docker Compose edge configuration. TLS_CERT_DIR must contain tls.crt and
# tls.key. Use an absolute host path with restricted permissions.
TLS_CERT_DIR=<absolute-host-path-to-tls-certificates>
HTTP_PORT=80
HTTPS_PORT=443
# Must exceed backend MAX_WORKBOOK_BYTES (20 MiB) including multipart overhead.
# Evidence uploads remain separately capped by EVIDENCE_MAX_UPLOAD_BYTES.
NGINX_CLIENT_MAX_BODY_SIZE=21m

JWT_ACCESS_SECRET=<generate-at-least-32-random-characters>
REFRESH_TOKEN_SECRET=<generate-a-different-random-secret>
JWT_ACCESS_TTL=15m
JWT_ISSUER=<approved-non-public-issuer>
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=true

CORS_ORIGINS=https://<approved-client-hostname>
FRONTEND_API_URL=/api/v1
PRODUCTION_DOMAIN=<approved-client-hostname>
TRUST_PROXY=1

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_API_MAX=600
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_REFRESH_MAX=60
RATE_LIMIT_DISABLED=false
JSON_BODY_LIMIT_BYTES=1048576

SERVE_FRONTEND=false
FRONTEND_DIST=/app/frontend-unused
PROTOTYPE_DIR=/app/prototype-disabled
ENABLE_API_DOCS=false
ENABLE_PROTOTYPE_ROUTES=false

FILE_STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=/var/lib/genbioca/evidence
IMPORT_PREVIEW_TTL_HOURS=24
IMPORT_PREVIEW_CLEANUP_INTERVAL_MS=3600000
EVIDENCE_ALLOWED_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.docx,.xlsx,.csv,.txt
EVIDENCE_MAX_UPLOAD_BYTES=10485760
EVIDENCE_UPLOAD_RATE_MAX=20
EVIDENCE_UPLOAD_RATE_WINDOW_MS=900000

LOG_LEVEL=info
BACKUP_PATH=/var/backups/genbioca
READINESS_STORAGE_CHECK=true
SHUTDOWN_TIMEOUT_MS=10000
DATABASE_CONNECTION_LIMIT=10
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_CONNECT_TIMEOUT_SECONDS=5
