FROM node:22-bookworm-slim AS dependencies
WORKDIR /app/backend
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl \
    && rm -rf /var/lib/apt/lists/*
COPY backend/package*.json ./
RUN npm ci

FROM dependencies AS build
COPY backend ./
RUN npm run prisma:generate && npm run build

FROM build AS production-dependencies
RUN npm prune --omit=dev

FROM node:22-bookworm-slim AS runtime
WORKDIR /app/backend
ENV NODE_ENV=production \
    HOME=/home/genbioca \
    XDG_CACHE_HOME=/home/genbioca/.cache
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl \
    && groupadd --system --gid 10001 genbioca \
    && useradd --system --uid 10001 --gid 10001 --create-home \
       --home-dir /home/genbioca --shell /usr/sbin/nologin genbioca \
    && mkdir -p /home/genbioca/.cache \
    && chown -R genbioca:genbioca /home/genbioca \
    && rm -rf /var/lib/apt/lists/*
COPY --chown=genbioca:genbioca --from=production-dependencies /app/backend/node_modules ./node_modules
COPY --chown=genbioca:genbioca --from=build /app/backend/dist ./dist
COPY --chown=genbioca:genbioca --from=build /app/backend/prisma ./prisma
COPY --chown=genbioca:genbioca backend/package*.json ./
USER 10001:10001
EXPOSE 8000
CMD ["node", "dist/src/server.js"]

FROM build AS migrate
ENV NODE_ENV=production
USER node
CMD ["npx", "prisma", "migrate", "deploy"]
