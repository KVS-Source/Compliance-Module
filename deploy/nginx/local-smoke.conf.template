server {
  listen 8080;
  server_name _;
  server_tokens off;
  # 21m covers the 20 MB workbook limit plus multipart encoding overhead.
  client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};

  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header X-Frame-Options "DENY" always;

  error_page 413 = @upload_too_large;

  location @upload_too_large {
    internal;
    default_type application/json;
    add_header X-Content-Type-Options "nosniff" always;
    return 413 '{"success":false,"error":{"code":"UPLOAD_TOO_LARGE","message":"The uploaded file exceeds the configured size limit."}}';
  }

  location /api/ {
    proxy_pass http://backend:8000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto http;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Request-Id $request_id;
  }

  location / {
    proxy_pass http://frontend:8080;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
  }
}
