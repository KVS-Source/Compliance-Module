{
  "info": {
    "name": "GenBioCa Policy API",
    "description": "Milestone 4 Slice 2 Policy workflow demo. Use synthetic .test identities only. Populate password variables locally; never commit secrets.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api/v1" }
  ],
  "item": [
    {
      "name": "1. Admin login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "pm.environment.set('accessToken', body.data.accessToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "2. List frameworks (capture id)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "const first = (body.data || [])[0];",
              "if (first) pm.environment.set('frameworkId', first.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/frameworks"
      }
    },
    {
      "name": "3. Create Policy",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "pm.environment.set('policyId', body.data.id);",
              "pm.environment.set('versionId', body.data.latestVersion.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Postman Controlled Policy\",\n  \"content\": \"Synthetic policy body for client demonstration.\",\n  \"requiresEvidence\": false,\n  \"frameworkIds\": [\"{{frameworkId}}\"]\n}"
        },
        "url": "{{baseUrl}}/policies"
      }
    },
    {
      "name": "4. List Policies",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/policies?page=1&pageSize=20"
      }
    },
    {
      "name": "5. View Policy",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/policies/{{policyId}}"
      }
    },
    {
      "name": "6. Update Policy",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Postman Controlled Policy (updated)\"\n}"
        },
        "url": "{{baseUrl}}/policies/{{policyId}}"
      }
    },
    {
      "name": "7. Create Version (MINOR)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "pm.environment.set('secondVersionId', body.data.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bump\": \"MINOR\",\n  \"content\": \"Revised synthetic policy body.\"\n}"
        },
        "url": "{{baseUrl}}/policies/{{policyId}}/versions"
      }
    },
    {
      "name": "8. Replace Framework mappings",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"frameworkIds\": [\"{{frameworkId}}\"]\n}"
        },
        "url": "{{baseUrl}}/policy-versions/{{secondVersionId}}/frameworks"
      }
    },
    {
      "name": "9. Submit Version",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{}" },
        "url": "{{baseUrl}}/policy-versions/{{secondVersionId}}/submit"
      }
    },
    {
      "name": "10. Self-approval (expect 403)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{}" },
        "url": "{{baseUrl}}/policy-versions/{{secondVersionId}}/approve"
      }
    },
    {
      "name": "11. Approver login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "pm.environment.set('approverToken', body.data.accessToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{approverEmail}}\",\n  \"password\": \"{{approverPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "12. Approve Version",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{approverToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{}" },
        "url": "{{baseUrl}}/policy-versions/{{secondVersionId}}/approve"
      }
    },
    {
      "name": "13. Version history",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/policies/{{policyId}}/versions"
      }
    },
    {
      "name": "14. Traceability",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/policies/{{policyId}}/traceability"
      }
    },
    {
      "name": "15. Audit events",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/policies/{{policyId}}/audit-events?page=1&pageSize=50"
      }
    },
    {
      "name": "16. Create Version for reject/resubmit",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "pm.environment.set('versionId', body.data.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bump\": \"MINOR\",\n  \"content\": \"Version prepared for reject and resubmit.\"\n}"
        },
        "url": "{{baseUrl}}/policies/{{policyId}}/versions"
      }
    },
    {
      "name": "17a. Submit for rejection",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{}" },
        "url": "{{baseUrl}}/policy-versions/{{versionId}}/submit"
      }
    },
    {
      "name": "17b. Reject Version",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{approverToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"comments\": \"Synthetic rejection reason for demonstration.\"\n}"
        },
        "url": "{{baseUrl}}/policy-versions/{{versionId}}/reject"
      }
    },
    {
      "name": "17c. Resubmit Version",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{}" },
        "url": "{{baseUrl}}/policy-versions/{{versionId}}/submit"
      }
    },
    {
      "name": "17d. Approve resubmitted Version",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{approverToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{}" },
        "url": "{{baseUrl}}/policy-versions/{{versionId}}/approve"
      }
    },
    {
      "name": "18. Permission denied (approver create)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{approverToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Should be forbidden\",\n  \"content\": \"Approver lacks policies:write by default.\"\n}"
        },
        "url": "{{baseUrl}}/policies"
      }
    },
    {
      "name": "19. Cross-tenant safe 404",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/policies/{{otherTenantPolicyId}}"
      }
    },
    {
      "name": "20. Archive Policy",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{}" },
        "url": "{{baseUrl}}/policies/{{policyId}}/archive"
      }
    }
  ]
}
