{
  "info": {
    "name": "GenBioCa Evidence API",
    "description": "Milestone 5 Evidence metadata, file upload, submit, review, and Control/Checkpoint linking. Synthetic .test identities only. Populate password variables locally; never commit secrets.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api/v1" }
  ],
  "item": [
    {
      "name": "1. Admin login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login succeeded', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.environment.set('accessToken', body.data.accessToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "2. Create Evidence",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Evidence created', function () { pm.response.to.have.status(201); });",
              "const body = pm.response.json();",
              "pm.environment.set('evidenceId', body.data.id);",
              "pm.test('DRAFT lifecycle', function () { pm.expect(body.data.lifecycleStatus).to.eql('DRAFT'); });",
              "pm.test('Server EVD code', function () { pm.expect(body.data.code).to.match(/^EVD-/); });",
              "pm.test('No storageKey', function () { pm.expect(body.data).to.not.have.property('storageKey'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Postman Synthetic Evidence\",\n  \"description\": \"Demonstrate Evidence metadata and file workflow\"\n}"
        },
        "url": "{{baseUrl}}/evidence"
      }
    },
    {
      "name": "3. View Evidence detail",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Detail returned', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test('No file yet', function () { pm.expect(body.data.hasFile).to.eql(false); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/evidence/{{evidenceId}}"
      }
    },
    {
      "name": "4. Upload file",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Upload succeeded', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test('hasFile true', function () { pm.expect(body.data.hasFile).to.eql(true); });",
              "pm.test('No storageKey', function () { pm.expect(body.data).to.not.have.property('storageKey'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "{{evidenceFixturePath}}",
              "description": "Use frontend/tests/fixtures/sample-evidence.txt relative to postman/ or absolute path locally."
            }
          ]
        },
        "url": "{{baseUrl}}/evidence/{{evidenceId}}/file"
      }
    },
    {
      "name": "5. Submit Evidence",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Submitted', function () { pm.response.to.have.status(200); });",
              "pm.test('SUBMITTED status', function () { pm.expect(pm.response.json().data.lifecycleStatus).to.eql('SUBMITTED'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{}" },
        "url": "{{baseUrl}}/evidence/{{evidenceId}}/submit"
      }
    },
    {
      "name": "6. Reviewer login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Reviewer login', function () { pm.response.to.have.status(200); });",
              "pm.environment.set('reviewerToken', pm.response.json().data.accessToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{reviewerEmail}}\",\n  \"password\": \"{{reviewerPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "7. Review queue",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{reviewerToken}}" }],
        "url": "{{baseUrl}}/evidence/review-queue?page=1&pageSize=20"
      }
    },
    {
      "name": "8. Approve Evidence",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Approved', function () { pm.response.to.have.status(200); });",
              "pm.test('APPROVED status', function () { pm.expect(pm.response.json().data.lifecycleStatus).to.eql('APPROVED'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{reviewerToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"reason\": \"Synthetic Postman approval.\"\n}"
        },
        "url": "{{baseUrl}}/evidence/{{evidenceId}}/approve"
      }
    },
    {
      "name": "9. Create Control (link target)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Control created', function () { pm.response.to.have.status(201); });",
              "pm.environment.set('controlId', pm.response.json().data.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Postman Synthetic Control for Evidence\",\n  \"objective\": \"Link target for Evidence demonstration\",\n  \"implementationStatus\": \"NOT_STARTED\",\n  \"controlType\": \"PREVENTIVE\",\n  \"frequency\": \"MONTHLY\",\n  \"verificationMethod\": \"Review linked Evidence\"\n}"
        },
        "url": "{{baseUrl}}/controls"
      }
    },
    {
      "name": "10. Create Checkpoint",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Checkpoint created', function () { pm.response.to.have.status(201); });",
              "pm.environment.set('checkpointId', pm.response.json().data.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"controlId\": \"{{controlId}}\",\n  \"title\": \"Postman Synthetic Checkpoint for Evidence\",\n  \"expectedResult\": \"Evidence gate demonstration\",\n  \"verificationFrequency\": \"MONTHLY\",\n  \"evidenceRequired\": true,\n  \"initialReviewDate\": \"2026-07-01\"\n}"
        },
        "url": "{{baseUrl}}/checkpoints"
      }
    },
    {
      "name": "11. Link Control on APPROVED (expect fail)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Non-DRAFT link rejected', function () { pm.expect(pm.response.code).to.be.oneOf([409, 422, 400]); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{}" },
        "url": "{{baseUrl}}/evidence/{{evidenceId}}/controls/{{controlId}}"
      }
    },
    {
      "name": "12. Create DRAFT Evidence for linking",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Second Evidence DRAFT', function () { pm.response.to.have.status(201); });",
              "pm.environment.set('evidenceId', pm.response.json().data.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Postman DRAFT Evidence for links\"\n}"
        },
        "url": "{{baseUrl}}/evidence"
      }
    },
    {
      "name": "13. Link Control on DRAFT",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Control linked', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{}" },
        "url": "{{baseUrl}}/evidence/{{evidenceId}}/controls/{{controlId}}"
      }
    },
    {
      "name": "14. Link Checkpoint on DRAFT",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{}" },
        "url": "{{baseUrl}}/evidence/{{evidenceId}}/checkpoints/{{checkpointId}}"
      }
    },
    {
      "name": "15. List Control links",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/evidence/{{evidenceId}}/controls?page=1&pageSize=20"
      }
    },
    {
      "name": "16. List Checkpoint links",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/evidence/{{evidenceId}}/checkpoints?page=1&pageSize=20"
      }
    },
    {
      "name": "17. Download file",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/evidence/{{evidenceId}}/file"
      }
    },
    {
      "name": "18. Audit events",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/evidence/{{evidenceId}}/audit-events?page=1&pageSize=20"
      }
    }
  ]
}
