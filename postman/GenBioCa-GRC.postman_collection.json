{
  "info": { "name": "GenBioCa GRC API", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "variable": [{ "key": "baseUrl", "value": "http://localhost:8000" }, { "key": "token", "value": "" }],
  "item": [
    { "name": "Health", "request": { "method": "GET", "url": "{{baseUrl}}/health" } },
    { "name": "Login", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"client_slug\":\"genbioca\",\"email\":\"admin@genbioca.example\",\"password\":\"ChangeMe-Admin-2026!\"}" }, "url": "{{baseUrl}}/api/v1/auth/login" } },
    { "name": "Dashboard", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/v1/dashboard/summary" } },
    { "name": "KPIs", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/v1/kpis" } },
    { "name": "Evidence upload", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": "" }, { "key": "evidence_code", "value": "EVD-NEW", "type": "text" }, { "key": "title", "value": "Supporting proof", "type": "text" }] }, "url": "{{baseUrl}}/api/v1/evidence/upload" } }
  ]
}
